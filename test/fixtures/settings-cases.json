{
  "settings": {
    "defaults": {
      "mount": "left", "theme": 2, "brightness": 180,
      "tz_name": "Europe/Berlin", "tz_rule": "CET-1CEST,M3.5.0,M10.5.0/3",
      "lat": "48.1374", "lon": "11.5755", "clock_format": "24h",
      "temp_unit": "celsius", "wind_unit": "kmh",
      "night": {"enabled": false, "start": 23, "end": 7, "brightness": 26},
      "portal": {"enabled": true, "password": "buddy1234"},
      "sitstand": {"sit_min": 30, "stand_min": 10},
      "pages": {"face": true, "clock": true, "date": true, "weather": true, "ip": true, "sitstand": true}
    },
    "cases": [
      {"name": "clock format", "op": "merge", "patch": {"clock_format": "12h"}, "ok": true, "config": {"clock_format": "12h"}},
      {"name": "bad clock format", "op": "merge", "patch": {"clock_format": "13h"}, "ok": false, "errors": {"clock_format": "must be \"24h\" or \"12h\""}},
      {"name": "night merges per field", "op": "merge", "patch": {"night": {"enabled": true}}, "ok": true, "config": {"night": {"enabled": true, "start": 23, "end": 7, "brightness": 26}}},
      {"name": "night hours must differ", "op": "merge", "patch": {"night": {"start": 7}}, "ok": false, "errors": {"night": "start and end must differ"}},
      {"name": "a theme in range", "op": "merge", "patch": {"theme": 4}, "ok": true, "config": {"theme": 4}},
      {"name": "a theme out of range", "op": "merge", "patch": {"theme": 9}, "ok": false, "errors": {"theme": "must be a whole number 0-4"}},
      {"name": "brightness in range", "op": "merge", "patch": {"brightness": 200}, "ok": true, "config": {"brightness": 200}},
      {"name": "brightness below minimum", "op": "merge", "patch": {"brightness": 7}, "ok": false, "errors": {"brightness": "a number from 8 to 255"}},
      {"name": "units", "op": "merge", "patch": {"temp_unit": "kelvin"}, "ok": false, "errors": {"temp_unit": "must be \"celsius\" or \"fahrenheit\""}},
      {"name": "one page off", "op": "merge", "patch": {"pages": {"ip": false}}, "ok": true, "config": {"pages": {"face": true, "clock": true, "date": true, "weather": true, "ip": false, "sitstand": true}}},
      {"name": "page not bool", "op": "merge", "patch": {"pages": {"clock": "yes"}}, "ok": false, "errors": {"pages.clock": "must be true or false"}},
      {"name": "unknown keys skipped", "op": "merge", "patch": {"v": 3, "ticker": "AAPL", "later": 1}, "ok": true, "config": {"theme": 2}},
      {"name": "portal password ok when enabled", "op": "merge", "patch": {"portal": {"enabled": true, "password": "newpass12"}}, "ok": true, "config": {"portal": {"enabled": true, "password": "newpass12"}}},
      {"name": "portal password too short when enabled", "op": "merge", "patch": {"portal": {"enabled": true, "password": "short"}}, "ok": false, "errors": {"portal": "password must be 8-26 characters when protection is on"}},
      {"name": "portal open", "op": "merge", "patch": {"portal": {"enabled": false, "password": ""}}, "ok": true, "config": {"portal": {"enabled": false, "password": ""}}},
      {"name": "sitstand minutes", "op": "merge", "patch": {"sitstand": {"sit_min": 45, "stand_min": 15}}, "ok": true, "config": {"sitstand": {"sit_min": 45, "stand_min": 15}}},
      {"name": "sitstand out of range", "op": "merge", "patch": {"sitstand": {"sit_min": 4, "stand_min": 61}}, "ok": false, "errors": {"sitstand.sit_min": "a whole number from 5 to 120", "sitstand.stand_min": "a whole number from 5 to 60"}},
      {"name": "load adds missing portal", "op": "load", "file": {"mount": "left", "theme": 2, "tz_name": "Europe/Berlin", "tz_rule": "CET-1CEST,M3.5.0,M10.5.0/3", "lat": "48.1374", "lon": "11.5755", "temp_unit": "celsius", "wind_unit": "kmh", "pages": {"face": true, "clock": true, "date": true, "weather": true}}, "added": ["brightness", "clock_format", "night", "portal", "sitstand", "pages.ip", "pages.sitstand"], "invalid": {}, "config": {}}
    ]
  },
  "demo": {
    "defaults": {"theme":2,"flags":{"a":true,"b":false},"night":{"enabled":false,"start":23,"end":7,"brightness":8},"names":["AAPL"],"coins":[{"pair":"BTC-USD","style":"coinbase"}]},
    "cases": [
      {"name": "a group field", "op": "merge", "patch":{"flags":{"b":true}},"ok":true,"config":{"flags":{"a":true,"b":true}}},
      {"name": "a group check against the current value", "op": "merge", "patch":{"night":{"start":7}},"ok":false,"errors":{"night":"start and end must differ"}},
      {"name": "a value list is replaced whole", "op": "merge", "patch":{"names":["MSFT","BRK.B"]},"ok":true,"config":{"names":["MSFT","BRK.B"]}},
      {"name": "an empty list", "op": "merge", "patch":{"names":[]},"ok":false,"errors":{"names":"1-5 entries"}},
      {"name": "records take the entry default", "op": "merge", "patch":{"coins":[{"pair":"SOL-EUR"}]},"ok":true,"config":{"coins":[{"pair":"SOL-EUR","style":"coinbase"}]}},
      {"name": "bad records", "op": "merge", "patch":{"coins":[{"pair":"BTCUSD"},7]},"ok":false,"errors":{"coins[0].pair":"3-21 characters: A-Z, 0-9 and one -","coins[1]":"must be an object"}}
    ]
  }
}