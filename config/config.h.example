#pragma once
// ============================================================
//  Monitor-Buddy — Benutzerkonfiguration
// ------------------------------------------------------------
//  WER BRAUCHT DIESE DATEI
//
//  Die meisten Nutzer brauchen sie nicht: der Web-Flasher setzt
//  alles unten und speichert es auf dem Board. Diese Datei ist
//  fuer Builds aus dem Quellcode. Ihre Werte sind die Defaults
//  fuer alles, was noch nicht auf dem Board gespeichert ist.
//  Gespeicherte Werte auf dem Board haben Vorrang.
//
//  SO NUTZT DU SIE (Quellcode-Builds)
//
//  1. Diese Datei nach  config/config.h  kopieren.
//  2.  config/config.h  oeffnen und die Werte unten anpassen.
//  3. config/config.h ist gitignored und darf nie committed
//     werden. Diese Vorlage ist die einzige getrackte Config.
//
//  Fehlt config/config.h, baut das Projekt trotzdem mit den
//  Default-Werten aus dieser Vorlage.
// ============================================================

// ── Montage ─────────────────────────────────────────────────
// Auf welcher Seite des Monitors der Buddy sitzt. RIGHT dreht
// Bildschirm, Touch und Augenbewegung um 180°.
#define MOUNTING_LOCATION LEFT   // LEFT oder RIGHT (Grossbuchstaben)

// ── Farbschema ──────────────────────────────────────────────
//   0 = Classic   (weiss auf schwarz)
//   1 = Minimal   (weiss/grau mit Cyan-Akzent)
//   2 = Semantic  (warme Farben fuer Wetter usw.)
//   3 = Warm amber
//   4 = Cool teal / blue
#define THEME 2

// ── Zeit ────────────────────────────────────────────────────
// TIMEZONE   IANA-Name — fuer die Wetteranfrage.
// TZ_RULE    Optionale POSIX-Regel fuer die Uhr mit Sommerzeit.
//            Leer = feste Regel aus TZ_OFFSET_HOURS.
// TZ_OFFSET_HOURS  UTC-Offset in Stunden, wenn TZ_RULE "".
#define TIMEZONE        "Europe/Berlin"
#define TZ_RULE         "CET-1CEST,M3.5.0,M10.5.0/3"
#define TZ_OFFSET_HOURS 1

// ── Wetter ──────────────────────────────────────────────────
#define LAT   "48.1374"
#define LONG  "11.5755"
#define TEMP  "celsius"
#define WIND  "kmh"

// ── Seiten ──────────────────────────────────────────────────
// Jede Seite ein- (true) oder ausschalten (false). Mindestens
// eine muss an bleiben — sonst wird die Gesichtsseite erzwungen.
#define SHOW_FACE      true   // animiertes Gesicht
#define SHOW_CLOCK     true   // Digitaluhr
#define SHOW_DATE      true   // Wochentag / Datum
#define SHOW_WEATHER   true   // Wetter (braucht WLAN)
#define SHOW_IP        true   // aktuelle IP-Adresse
#define SHOW_SITSTAND  true   // Steh/Sitz-Timer

// ── Steh/Sitz-Timer (Minuten) ───────────────────────────────
#define SIT_MINUTES    30
#define STAND_MINUTES  10

// ── Setup-Hotspot-Passwort ──────────────────────────────────
// PORTAL_PROTECT: true = Hotspot mit Passwort, false = offen.
// PORTAL_PASS: 8-26 Zeichen, wenn Schutz an ist.
#define PORTAL_PROTECT true
#define PORTAL_PASS    "buddy1234"

// ── Uhr und Nachtmodus ──────────────────────────────────────
#define CLOCK_12H        false
#define NIGHT_MODE       false
#define NIGHT_START_HOUR 23
#define NIGHT_END_HOUR   7
#define NIGHT_BRIGHTNESS 26
#define NIGHT_WAKE_MS    30000UL

// ── Setup-Hotspot Name (optional, nur Quellcode-Builds) ─────
// AP_SSID: 1-26 Zeichen. Das Passwort kommt aus den Settings
// (PORTAL_* oben bzw. Web-Flasher).
// #define AP_SSID "Monitor-Buddy-Setup"
